{
  "name": "MultiPlatformLiveVideoRecorder",
  "version": "1.3.5-fork.0",
  "author": "ZuoBro <zuobro@163.com>",
  "description": "多平台聚合直播录制（fork 维护版）",
  "license": "GPL-3.0",
  "main": "./dist/electron/main.js",
  "scripts": {
    "prebuild": "node scripts/copy-vendor.js",
    "predev": "node scripts/copy-vendor.js",
    "prepack": "node scripts/copy-vendor.js",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js && electron-builder --publish never",
    "build:dir": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js",
    "build:web": "cross-env BUILD_TARGET=web NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js",
    "build:full": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider webpack --progress --colors --config .electron-vue/webpack.main.config.js && cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider webpack --progress --colors --config .electron-vue/webpack.renderer.config.js && cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js && electron-builder",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/dev-runner.js",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider webpack --progress --colors --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider webpack --progress --colors --config .electron-vue/webpack.renderer.config.js",
    "test": "node --test"
  },
  "build": {
    "productName": "MPLVR 多平台聚合直播录制",
    "appId": "top.lyfzn.mplvr",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "./static/icon.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "linux": {
      "icon": "./static/icon.ico"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "crypto-js": "^4.2.0",
    "element-ui": "^2.15.14",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs": "^0.0.1-security",
    "fs-extra": "^10.1.0",
    "linkedom": "^0.14.9",
    "log4js": "^6.9.1",
    "nedb": "^1.8.0",
    "query-string": "^7.1.3",
    "readline": "^1.3.0",
    "uuid": "^3.4.0",
    "vue": "2.6.14",
    "vue-electron": "^1.0.6",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "vuex-electron": "^1.0.3"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.4.4",
    "ajv": "^6.12.6",
    "babel-core": "^6.26.3",
    "babel-eslint": "^8.2.6",
    "babel-loader": "^7.1.5",
    "babel-minify-webpack-plugin": "^0.3.1",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-stage-0": "^6.24.1",
    "babel-register": "^6.26.0",
    "bufferutil": "^4.0.9",
    "cfonts": "^2.1.2",
    "chalk": "^2.4.2",
    "copy-webpack-plugin": "^4.6.0",
    "cross-env": "^5.2.1",
    "css-loader": "^0.28.11",
    "del": "^3.0.0",
    "devtron": "^1.4.0",
    "electron": "^11.5.0",
    "electron-builder": "^22.14.13",
    "electron-debug": "^1.5.0",
    "electron-devtools-installer": "^2.2.4",
    "eslint": "^4.19.1",
    "eslint-config-standard": "^11.0.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-html": "^4.0.3",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-node": "^6.0.1",
    "eslint-plugin-promise": "^3.8.0",
    "eslint-plugin-standard": "^3.1.0",
    "file-loader": "^1.1.11",
    "html-webpack-plugin": "^3.2.0",
    "listr": "^0.14.3",
    "mini-css-extract-plugin": "0.4.5",
    "node-loader": "^0.6.0",
    "style-loader": "^0.21.0",
    "url-loader": "^1.1.2",
    "utf-8-validate": "^5.0.10",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.2",
    "vue-template-compiler": "2.6.14",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^4.2.2"
  }
}
